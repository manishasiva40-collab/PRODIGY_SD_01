#include <iostream>
#include <fstream>
#include <vector>
#include <string>

using namespace std;

struct Contact {
    string name;
    string phone;
    string email;
};

vector<Contact> contacts;

// Load contacts from file
void loadContacts() {
    ifstream file("contacts.txt");
    Contact c;

    while (getline(file, c.name) &&
           getline(file, c.phone) &&
           getline(file, c.email)) {
        contacts.push_back(c);
    }

    file.close();
}

// Save contacts to file
void saveContacts() {
    ofstream file("contacts.txt");

    for (const auto &c : contacts) {
        file << c.name << endl;
        file << c.phone << endl;
        file << c.email << endl;
    }

    file.close();
}

// Add contact
void addContact() {
    Contact c;

    cin.ignore();
    cout << "Enter Name: ";
    getline(cin, c.name);

    cout << "Enter Phone Number: ";
    getline(cin, c.phone);

    cout << "Enter Email Address: ";
    getline(cin, c.email);

    contacts.push_back(c);
    saveContacts();

    cout << "Contact added successfully!\n";
}

// View contacts
void viewContacts() {
    if (contacts.empty()) {
        cout << "No contacts available.\n";
        return;
    }

    cout << "\n--- Contact List ---\n";
    for (size_t i = 0; i < contacts.size(); i++) {
        cout << "\nContact #" << i + 1 << endl;
        cout << "Name : " << contacts[i].name << endl;
        cout << "Phone: " << contacts[i].phone << endl;
        cout << "Email: " << contacts[i].email << endl;
    }
}

// Edit contact
void editContact() {
    int index;

    viewContacts();

    cout << "\nEnter contact number to edit: ";
    cin >> index;

    if (index < 1 || index > contacts.size()) {
        cout << "Invalid contact number.\n";
        return;
    }

    cin.ignore();

    cout << "Enter New Name: ";
    getline(cin, contacts[index - 1].name);

    cout << "Enter New Phone Number: ";
    getline(cin, contacts[index - 1].phone);

    cout << "Enter New Email Address: ";
    getline(cin, contacts[index - 1].email);

    saveContacts();

    cout << "Contact updated successfully!\n";
}

// Delete contact
void deleteContact() {
    int index;

    viewContacts();

    cout << "\nEnter contact number to delete: ";
    cin >> index;

    if (index < 1 || index > contacts.size()) {
        cout << "Invalid contact number.\n";
        return;
    }

    contacts.erase(contacts.begin() + index - 1);
    saveContacts();

    cout << "Contact deleted successfully!\n";
}

int main() {
    loadContacts();

    int choice;

    do {
        cout << "\n===== Contact Management System =====\n";
        cout << "1. Add Contact\n";
        cout << "2. View Contacts\n";
        cout << "3. Edit Contact\n";
        cout << "4. Delete Contact\n";
        cout << "5. Exit\n";
        cout << "Enter Choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                addContact();
                break;
            case 2:
                viewContacts();
                break;
            case 3:
                editContact();
                break;
            case 4:
                deleteContact();
                break;
            case 5:
                cout << "Exiting program...\n";
                break;
            default:
                cout << "Invalid choice.\n";
        }

    } while (choice != 5);

    return 0;
}
